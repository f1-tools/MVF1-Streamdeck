{
	"Name": "MultiViewer StreamDeck",
	"Version": "0.1.0.0",
	"Author": "F1-Tools",
	"Actions": [
		{
			"Name": "Sync All Players and Data Stream",
			"UUID": "com.f1-tools.multiviewer-streamdeck.sync",
			"Icon": "imgs/actions/PNG/sync",
			"Tooltip": "Syncs all players and the data stream to commentary or the oldest player",
			"PropertyInspectorPath": "ui/sync.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/PNG/sync"
				}
			]
		},
		{
			"Name": "Play/Pause All Players",
			"UUID": "com.f1-tools.multiviewer-streamdeck.pause-play",
			"Icon": "imgs/actions/PNG/pause",
			"Tooltip": "Pauses or plays all players, followed by an automatic sync",
			"PropertyInspectorPath": "ui/pause-play.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/PNG/pause"
				},
				{
					"Image": "imgs/actions/PNG/play"
				}
			]
		},
		{
			"Name": "Rewind All Players",
			"UUID": "com.f1-tools.multiviewer-streamdeck.rewind",
			"Icon": "imgs/actions/PNG/rewind",
			"Tooltip": "Rewinds all Players, sync is not guaranteed to be maintained",
			"PropertyInspectorPath": "ui/rewind.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/PNG/rewind"
				}
			]
		},
		{
			"Name": "Fast Forward All Players",
			"UUID": "com.f1-tools.multiviewer-streamdeck.forward",
			"Icon": "imgs/actions/PNG/forward",
			"Tooltip": "Fast Forwards all Players, sync is not guaranteed to be maintained",
			"PropertyInspectorPath": "ui/forward.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/PNG/forward"
				}
			]
		}
	],
	"Category": "MultiViewer StreamDeck",
	"CategoryIcon": "imgs/plugin/mv_logo",
	"CodePath": "bin/plugin.js",
	"Description": "A Stream Deck Plugin used for controlling the MutliViewer application and its many windows. ",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "6.4"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20",
		"Debug": "enabled"
	},
	"UUID": "com.f1-tools.multiviewer-streamdeck"
}